{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frviana/hermes-ui/backend/schema/widget.schema.json",
  "additionalProperties": false,
  "description": "``widget.json``: one installable widget (docs/smart-home/WIDGET_STANDARD.md). Generated by `python -m hermes_ui.widgets.codegen` from backend/hermes_ui/widgets/. Do not edit.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional, for editors: the schema this file follows.",
      "title": "$Schema"
    },
    "manifest_version": {
      "const": 1,
      "title": "Manifest Version",
      "type": "integer"
    },
    "id": {
      "description": "Stable and namespaced by its author, lowercase: 'author.widget-name'. Built-in widget types never contain a dot, so the two can't collide.",
      "maxLength": 80,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 40,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "description": "Semantic version of this widget, e.g. '1.2.0'.",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "author": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
      "title": "Author",
      "type": "string"
    },
    "description": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
      "title": "Description",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "description": "An SPDX licence identifier, e.g. 'MIT', or 'LicenseRef-…'.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "icon": {
      "enum": [
        "bolt",
        "box",
        "bulb",
        "check",
        "clock",
        "fan",
        "home",
        "leaf",
        "minus",
        "music",
        "pause",
        "play",
        "plus",
        "sparkles",
        "speaker",
        "sun",
        "thermo"
      ],
      "title": "Icon",
      "type": "string"
    },
    "tint": {
      "default": "blue",
      "enum": [
        "blue",
        "red",
        "orange",
        "amber",
        "pink",
        "violet",
        "indigo",
        "green",
        "teal",
        "yellow",
        "brown"
      ],
      "title": "Tint",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime"
    },
    "device_classes": {
      "description": "The classes the device picker offers; one device per widget instance. Sensitive classes (lock, garage_door, gate, alarm, camera) are refused.",
      "items": {
        "enum": [
          "light",
          "switch",
          "plug",
          "fan",
          "sensor",
          "thermostat",
          "cover",
          "media_player",
          "other"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Device Classes",
      "type": "array"
    },
    "permissions": {
      "description": "'device:read' always; 'device:command' exactly when a view has a control.",
      "items": {
        "enum": [
          "device:read",
          "device:command"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Permissions",
      "type": "array"
    },
    "default_size": {
      "enum": [
        "s",
        "m",
        "l"
      ],
      "title": "Default Size",
      "type": "string"
    },
    "views": {
      "$ref": "#/$defs/Views"
    }
  },
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "author",
    "description",
    "icon",
    "runtime",
    "device_classes",
    "permissions",
    "default_size",
    "views"
  ],
  "title": "WidgetManifest",
  "type": "object",
  "x-manifest-version": 1,
  "x-runtime-version": 1,
  "$defs": {
    "ButtonNode": {
      "additionalProperties": false,
      "description": "One action without a value.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "button",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "enum": [
            "on_off.turn_on",
            "on_off.turn_off",
            "media_player.play",
            "media_player.pause",
            "media_player.stop",
            "media_player.next",
            "media_player.previous",
            "cover.open",
            "cover.close",
            "cover.stop"
          ],
          "title": "Action",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Label",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "enum": [
                "bolt",
                "box",
                "bulb",
                "check",
                "clock",
                "fan",
                "home",
                "leaf",
                "minus",
                "music",
                "pause",
                "play",
                "plus",
                "sparkles",
                "speaker",
                "sun",
                "thermo"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        }
      },
      "required": [
        "kind",
        "action",
        "label"
      ],
      "title": "ButtonNode",
      "type": "object"
    },
    "CapabilityCondition": {
      "additionalProperties": false,
      "description": "Shown when the assigned device has this capability.",
      "properties": {
        "has": {
          "enum": [
            "on_off",
            "brightness",
            "color",
            "temperature_sensor",
            "humidity_sensor",
            "thermostat",
            "cover",
            "contact_sensor",
            "motion_sensor",
            "media_player"
          ],
          "title": "Has",
          "type": "string"
        }
      },
      "required": [
        "has"
      ],
      "title": "CapabilityCondition",
      "type": "object"
    },
    "ChoiceNode": {
      "additionalProperties": false,
      "description": "One of the options the device itself lists (e.g. its thermostat modes).",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "choice",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "const": "state.thermostat_mode",
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "label"
      ],
      "title": "ChoiceNode",
      "type": "object"
    },
    "FieldCondition": {
      "additionalProperties": false,
      "description": "Shown when a field equals (``eq``) or differs from (``ne``) a constant; ``null`` means not reported.",
      "properties": {
        "field": {
          "enum": [
            "device.name",
            "device.room",
            "device.availability",
            "state.on",
            "state.brightness",
            "state.color_mode",
            "state.hue",
            "state.saturation",
            "state.color_temp_kelvin",
            "state.temperature",
            "state.humidity",
            "state.contact_open",
            "state.motion",
            "state.current_temperature",
            "state.target_temperature",
            "state.thermostat_mode",
            "state.hvac_action",
            "state.position",
            "state.cover_state",
            "state.playback",
            "state.volume",
            "state.muted",
            "state.media_title",
            "state.media_artist",
            "state.updated_at"
          ],
          "title": "Field",
          "type": "string"
        },
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "ne"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "title": "FieldCondition",
      "type": "object"
    },
    "IconNode": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "icon",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "enum": [
            "bolt",
            "box",
            "bulb",
            "check",
            "clock",
            "fan",
            "home",
            "leaf",
            "minus",
            "music",
            "pause",
            "play",
            "plus",
            "sparkles",
            "speaker",
            "sun",
            "thermo"
          ],
          "title": "Name",
          "type": "string"
        },
        "tint": {
          "anyOf": [
            {
              "enum": [
                "blue",
                "red",
                "orange",
                "amber",
                "pink",
                "violet",
                "indigo",
                "green",
                "teal",
                "yellow",
                "brown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tint"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "IconNode",
      "type": "object"
    },
    "RowNode": {
      "additionalProperties": false,
      "description": "Children left to right.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "row",
          "title": "Kind",
          "type": "string"
        },
        "gap": {
          "default": "m",
          "enum": [
            "none",
            "s",
            "m",
            "l"
          ],
          "title": "Gap",
          "type": "string"
        },
        "justify": {
          "default": "start",
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ],
          "title": "Justify",
          "type": "string"
        },
        "align": {
          "default": "center",
          "enum": [
            "start",
            "center",
            "end",
            "baseline"
          ],
          "title": "Align",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "button": "#/$defs/ButtonNode",
                "choice": "#/$defs/ChoiceNode",
                "icon": "#/$defs/IconNode",
                "row": "#/$defs/RowNode",
                "slider": "#/$defs/SliderNode",
                "spacer": "#/$defs/SpacerNode",
                "stack": "#/$defs/StackNode",
                "status": "#/$defs/StatusNode",
                "stepper": "#/$defs/StepperNode",
                "text": "#/$defs/TextNode",
                "toggle": "#/$defs/ToggleNode",
                "value": "#/$defs/ValueNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StackNode"
              },
              {
                "$ref": "#/$defs/RowNode"
              },
              {
                "$ref": "#/$defs/SpacerNode"
              },
              {
                "$ref": "#/$defs/TextNode"
              },
              {
                "$ref": "#/$defs/ValueNode"
              },
              {
                "$ref": "#/$defs/IconNode"
              },
              {
                "$ref": "#/$defs/StatusNode"
              },
              {
                "$ref": "#/$defs/ToggleNode"
              },
              {
                "$ref": "#/$defs/SliderNode"
              },
              {
                "$ref": "#/$defs/StepperNode"
              },
              {
                "$ref": "#/$defs/ChoiceNode"
              },
              {
                "$ref": "#/$defs/ButtonNode"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "children"
      ],
      "title": "RowNode",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "description": "How the widget runs. Only ``declarative`` exists today; a sandboxed kind may come later (ADR 0008 §8).",
      "properties": {
        "kind": {
          "const": "declarative",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "SliderNode": {
      "additionalProperties": false,
      "description": "A value within the device's own range; changes are gathered and sent once.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "slider",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "enum": [
            "state.brightness",
            "state.volume",
            "state.position",
            "state.color_temp_kelvin"
          ],
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "label"
      ],
      "title": "SliderNode",
      "type": "object"
    },
    "SpacerNode": {
      "additionalProperties": false,
      "description": "Takes the free space, pushing what follows to the end.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "spacer",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SpacerNode",
      "type": "object"
    },
    "StackNode": {
      "additionalProperties": false,
      "description": "Children top to bottom.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "stack",
          "title": "Kind",
          "type": "string"
        },
        "gap": {
          "default": "m",
          "enum": [
            "none",
            "s",
            "m",
            "l"
          ],
          "title": "Gap",
          "type": "string"
        },
        "align": {
          "default": "stretch",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "title": "Align",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "button": "#/$defs/ButtonNode",
                "choice": "#/$defs/ChoiceNode",
                "icon": "#/$defs/IconNode",
                "row": "#/$defs/RowNode",
                "slider": "#/$defs/SliderNode",
                "spacer": "#/$defs/SpacerNode",
                "stack": "#/$defs/StackNode",
                "status": "#/$defs/StatusNode",
                "stepper": "#/$defs/StepperNode",
                "text": "#/$defs/TextNode",
                "toggle": "#/$defs/ToggleNode",
                "value": "#/$defs/ValueNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StackNode"
              },
              {
                "$ref": "#/$defs/RowNode"
              },
              {
                "$ref": "#/$defs/SpacerNode"
              },
              {
                "$ref": "#/$defs/TextNode"
              },
              {
                "$ref": "#/$defs/ValueNode"
              },
              {
                "$ref": "#/$defs/IconNode"
              },
              {
                "$ref": "#/$defs/StatusNode"
              },
              {
                "$ref": "#/$defs/ToggleNode"
              },
              {
                "$ref": "#/$defs/SliderNode"
              },
              {
                "$ref": "#/$defs/StepperNode"
              },
              {
                "$ref": "#/$defs/ChoiceNode"
              },
              {
                "$ref": "#/$defs/ButtonNode"
              }
            ]
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "children"
      ],
      "title": "StackNode",
      "type": "object"
    },
    "StatusNode": {
      "additionalProperties": false,
      "description": "The host's status line: offline, connection down, stale, and the outcome of the last change.\nAdded at the end of the view when a view has none.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "status",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StatusNode",
      "type": "object"
    },
    "StepperNode": {
      "additionalProperties": false,
      "description": "− and + on the device's own step and limits.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "stepper",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "const": "state.target_temperature",
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "label"
      ],
      "title": "StepperNode",
      "type": "object"
    },
    "TextNode": {
      "additionalProperties": false,
      "description": "Fixed text from the manifest.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
          "title": "When"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Text",
          "type": "string"
        },
        "style": {
          "default": "body",
          "enum": [
            "display",
            "title",
            "body",
            "caption"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextNode",
      "type": "object"
    },
    "ToggleNode": {
      "additionalProperties": false,
      "description": "On and off (or muted), sent as an explicit target, never as a toggle of a state that may be stale.",
      "properties": {
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCondition"
            },
            {
              "$ref": "#/$defs/CapabilityCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Show this component only when the condition holds.",
