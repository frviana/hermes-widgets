{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frviana/hermes-ui/backend/schema/catalog-index.schema.json",
  "additionalProperties": false,
  "description": "``catalog/index.json`` in the catalog repository. For the published schema; the portal reads an index\nentry by entry (``parse_index``), so one bad entry is left out instead of hiding the whole catalog. Generated by `python -m hermes_ui.widgets.codegen` from backend/hermes_ui/widgets/. Do not edit.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional, for editors: the schema this file follows.",
      "title": "$Schema"
    },
    "catalog_version": {
      "const": 1,
      "title": "Catalog Version",
      "type": "integer"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/CatalogEntry"
      },
      "maxItems": 300,
      "title": "Widgets",
      "type": "array"
    }
  },
  "required": [
    "catalog_version",
    "widgets"
  ],
  "title": "CatalogIndex",
  "type": "object",
  "x-catalog-version": 1,
  "$defs": {
    "CatalogEntry": {
      "additionalProperties": false,
      "description": "One listed widget: where its ``widget.json`` is, pinned, and a copy of its identity.",
      "properties": {
        "id": {
          "description": "Stable and namespaced by its author, lowercase: 'author.widget-name'. Built-in widget types never contain a dot, so the two can't collide.",
          "maxLength": 80,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Name",
          "type": "string"
        },
        "author": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Author",
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f‪-‮⁦-⁩]*$",
          "title": "Description",
          "type": "string"
        },
        "version": {
          "description": "Semantic version of this widget, e.g. '1.2.0'.",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "icon": {
          "enum": [
            "bolt",
            "box",
            "bulb",
            "check",
            "clock",
            "fan",
            "home",
            "leaf",
            "minus",
            "music",
            "pause",
            "play",
            "plus",
            "sparkles",
            "speaker",
            "sun",
            "thermo"
          ],
          "title": "Icon",
          "type": "string"
        },
        "device_classes": {
          "items": {
            "enum": [
              "light",
              "switch",
              "plug",
              "fan",
              "sensor",
              "thermostat",
              "cover",
              "media_player",
              "other"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Device Classes",
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "repo": {
          "description": "owner/repository on GitHub.",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$",
          "title": "Repo",
          "type": "string"
        },
        "path": {
          "default": "",
          "description": "The folder holding widget.json, relative to the repository root; '' for the root.",
          "maxLength": 200,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*)?$",
          "title": "Path",
          "type": "string"
        },
        "commit": {
          "description": "The full commit the widget is pinned to; never a branch.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._/-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The release tag at that commit, for display only.",
          "title": "Tag"
        },
        "manifest_sha256": {
          "description": "SHA-256 of widget.json's bytes at that commit.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "author",
        "description",
        "version",
        "icon",
        "device_classes",
        "runtime",
        "repo",
        "commit",
        "manifest_sha256"
      ],
      "title": "CatalogEntry",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "description": "How the widget runs. Only ``declarative`` exists today; a sandboxed kind may come later (ADR 0008 §8).",
      "properties": {
        "kind": {
          "const": "declarative",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "Runtime",
      "type": "object"
    }
  }
}
